local function getAimPart(char)
    if not char then return nil end
    return char:FindFirstChild(State.AimPart)
        or char:FindFirstChild("Head")
        or char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
end

local function getClosestPlayer()
    local target = nil
    local mousePos = UIS:GetMouseLocation()
    local maxDist = State.FOV
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local char = plr.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and hrp then
                local teamOk = not State.AimTeamCheck or (plr.Team ~= LP.Team)
                if teamOk then
                    local screen, onScreen = Camera:WorldToScreenPoint(hrp.Position)
                    if onScreen then
                        local dist = (Vector2.new(mousePos.X, mousePos.Y) - Vector2.new(screen.X, screen.Y)).Magnitude
                        if dist < maxDist then
                            target = plr
                            maxDist = dist
                        end
                    end
                end
            end
        end
    end
    return target
end

