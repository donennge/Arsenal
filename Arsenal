    local head = player.Character:FindFirstChild("Head")
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    if head and head:FindFirstChild("KB_name_esp") then head.KB_name_esp:Destroy() end
    if hrp and hrp:FindFirstChild("KB_box_esp") then hrp.KB_box_esp:Destroy() end
end

local function updateESPStyle(player)
    if not player or not player.Character then return end
    local head = player.Character:FindFirstChild("Head")
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    if head then
        local bb = head:FindFirstChild("KB_name_esp")
        if bb then bb.Enabled = State.ESPName end
    end
    if hrp then
        local bb = hrp:FindFirstChild("KB_box_esp")
        if bb then bb.Enabled = State.ESPBox end
    end
end

local function refreshESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            if State.ESPEnable then
                local teamSkip = State.ESPTeamCheck and plr.Team == LP.Team
                if not teamSkip then
                    buildESPFor(plr)
                    updateESPStyle(plr)
                else
                    clearESPFor(plr)
                end
            else
                clearESPFor(plr)
            end
        end
    end
end

task.spawn(function()
    while task.wait(0.4) do
        pcall(refreshESP)
    end
end)

