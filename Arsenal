            Text=opt, Font=Enum.Font.GothamMedium, TextSize=12,
            TextColor3=C.muted, BorderSizePixel=0,
        },box)
        corner(b,6)
        buttons[opt]=b
        b.Activated:Connect(function()
            sfx("select"); choose(opt); open=false
            tween(box,0.3,{Size=UDim2.new(1,0,0,closedH)})
            tween(arrow,0.3,{Rotation=0})
        end)
    end
    head.Activated:Connect(function()
        sfx("select"); open=not open
        tween(box,0.38,{Size=UDim2.new(1,0,0,open and openH or closedH)},Enum.EasingStyle.Quint)
        tween(arrow,0.3,{Rotation=open and 180 or 0})
    end)
    choose(ctrl.default,true)
end

